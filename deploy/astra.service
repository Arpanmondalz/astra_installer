[Unit]
Description=Astra telescope camera server
After=network.target
# Without this, systemd's default rate limit (5 starts in 10s) permanently
# gives up on the unit after a boot-time camera hiccup and only a reboot
# brings it back. That was the original "needs multiple reboots" bug.
StartLimitIntervalSec=0

[Service]
Type=simple
User=__USER__
SupplementaryGroups=video render
WorkingDirectory=__WORKDIR__
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m astra
Restart=always
RestartSec=5

# Binding port 80 without running the whole server as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=true

[Install]
WantedBy=multi-user.target
